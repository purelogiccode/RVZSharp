<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\RVZSharp\RVZSharp.csproj" />
    <!-- CP1252 / Shift-JIS decoders for the disc internal name (Dolphin: Volume::DecodeString). -->
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.11" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Meziantou.Analyzer" Version="3.0.156">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The CLI targets net8.0 only so the built tool runs on .NET 8, 9 and 10 runtimes
         alike, and plain dotnet run on this project needs no target-framework flag.
         (Explicitly overrides the multi-targeting in Directory.Build.props.) -->
    <TargetFrameworks>net8.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Icon embedded in the built rvzsharp executable (Windows explorer). -->
    <ApplicationIcon>icon\icon.ico</ApplicationIcon>
    <Company>PureLogicCode.com</Company>
    <AssemblyVersion>1.0.0</AssemblyVersion>
    <FileVersion>1.0.0</FileVersion>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

</Project>
