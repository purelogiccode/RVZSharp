<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Company>PureLogicCode.com</Company>
        <AssemblyVersion>1.1.0</AssemblyVersion>
        <FileVersion>1.1.0</FileVersion>
        <NeutralLanguage>en</NeutralLanguage>
        <!-- Native AOT / trimming: the library is fully reflection-free, so the trim and AOT
         analyzers must stay clean for every target framework. -->
        <IsAotCompatible>true</IsAotCompatible>
        <IsTrimmable>true</IsTrimmable>
    </PropertyGroup>

    <!-- NuGet package metadata (dotnet pack). -->
    <PropertyGroup>
        <PackageId>RVZSharp</PackageId>
        <Title>RVZSharp</Title>
        <Description>
            A pure managed .NET library for reading and writing Dolphin RVZ/WIA disc images and
            decoding the legacy GameCube/Wii formats (GCZ, CISO/WBI, WBFS, TGC, NFS) to a canonical
            ISO view. Written by Peterson Fernandes (Pure Logic Code); the RVZ/WIA format logic is
            derived from Dolphin and the library is GPL-2.0-or-later, like Dolphin itself.
        </Description>
        <PackageTags>dolphin;rvz;wia;gcz;ciso;wbfs;tgc;nfs;gamecube;wii;iso;disc-image</PackageTags>
        <PackageLicenseExpression>GPL-2.0-or-later</PackageLicenseExpression>
        <PackageIcon>icon.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PackageReleaseNotes>
            1.1.0: legacy writers (CisoWriter, WbfsWriter, TgcWriter), the DiscVerifier Wii
            hash-tree/TMD/H3 verifier, thread-safe ReadAt with an LRU cache, the async API,
            split plain ISO, DiscInfo, BlobStream and scrub options; CLI --json output, -
            stdin/stdout piping and shell completions; CI with API-compat validation and an
            embedded SPDX SBOM. Fixes: partition keys are common-key decrypted from the ticket
            (verify/extract work on real encrypted discs), extract TMD/cert/H3 offsets, WBFS
            header size/disc-header copy, convert --json stdout hygiene, Ctrl+C exit 130 and
            monotonic writer progress. Public API stays compatible with 1.0.0.
        </PackageReleaseNotes>
        <RepositoryUrl>https://github.com/purelogiccode/RVZSharp</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageProjectUrl>https://github.com/purelogiccode/RVZSharp</PackageProjectUrl>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <!-- No symbols package: Directory.Build.props embeds the PDBs in the assemblies
         (important for single-file publishes), so an .snupkg would carry no .pdb files and
         nuget.org rejects it ("does not contain any symbol files"). Debuggers read the
         embedded PDBs directly. -->
        <IncludeSymbols>false</IncludeSymbols>
        <!-- Validates that every target framework (net8.0/net9.0/net10.0) asset is compatible
         with the package's supported frameworks, and that the public API stays compatible
         with the last published release (1.0.0). Breaking changes must be suppressed with a
         justification in CompatibilitySuppressions.xml (see docs/packaging.md). -->
        <EnablePackageValidation>true</EnablePackageValidation>
        <PackageValidationBaselineVersion>1.0.0</PackageValidationBaselineVersion>
        <!-- SPDX 2.2 SBOM for the package, generated next to the nupkg on Release builds
         (Microsoft.Sbom.Targets). Kept out of Debug builds to keep the dev loop fast. -->
        <GenerateSBOM Condition="'$(Configuration)' == 'Release'">true</GenerateSBOM>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="LZMA-SDK" Version="22.1.1" />
        <PackageReference Include="Roslynator.Analyzers" Version="5.0.1">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="SharpZipLib" Version="1.4.2" />
        <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" PrivateAssets="all" />
        <PackageReference Include="Microsoft.Sbom.Targets" Version="4.1.13" PrivateAssets="all" />
        <PackageReference Include="Meziantou.Analyzer" Version="3.0.297">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\" />
        <None Include="..\LICENSE" Pack="true" PackagePath="\" />
        <None Include="..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
        <None Include="icon\icon.png" Pack="true" PackagePath="/" />
    </ItemGroup>

</Project>
