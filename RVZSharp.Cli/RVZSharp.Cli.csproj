<Project Sdk="Microsoft.NET.Sdk">

    <ItemGroup>
        <ProjectReference Include="..\RVZSharp\RVZSharp.csproj" />
        <PackageReference Include="Roslynator.Analyzers" Version="5.0.1">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <!-- CP1252 / Shift-JIS decoders for the disc internal name: provided in-box on every
         supported target framework (Dolphin: Volume::DecodeString). -->
        <PackageReference Include="Serilog" Version="4.4.0" />
        <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
        <PackageReference Include="Meziantou.Analyzer" Version="3.0.342">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <!-- The CLI ships as a multi-target .NET tool (net8.0 through net11.0) and as
         framework-dependent single-file release binaries. -->
        <TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>true</IsPackable>
        <!-- NuGet tool package, installed with: dotnet tool install -g RVZSharp.Cli -->
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>rvzsharp</ToolCommandName>
        <PackageId>RVZSharp.Cli</PackageId>
        <Title>RVZSharp CLI</Title>
        <Description>
            Command-line tool for Dolphin RVZ/WIA, GCZ, CISO/WBI, WBFS, TGC, NFS and ISO
            disc images. Convert, inspect, verify and extract GameCube/Wii disc images.
        </Description>
        <PackageTags>dolphin;rvz;wia;gcz;ciso;wbfs;tgc;nfs;gamecube;wii;iso;disc-image;cli;tool</PackageTags>
        <PackageLicenseExpression>GPL-2.0-or-later</PackageLicenseExpression>
        <PackageIcon>icon.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <RepositoryUrl>https://github.com/purelogiccode/RVZSharp</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageProjectUrl>https://github.com/purelogiccode/RVZSharp</PackageProjectUrl>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <!-- Embedded PDBs mean no symbols package is useful (same policy as the library). -->
        <IncludeSymbols>false</IncludeSymbols>
        <!-- Icon embedded in the built rvzsharp executable (Windows explorer). -->
        <ApplicationIcon>icon\icon.ico</ApplicationIcon>
        <Company>PureLogicCode.com</Company>
        <!-- AssemblyVersion/FileVersion follow Directory.Build.props' Version (1.3.0), so
         the binary, telemetry and the update check all report the same product version. -->
        <NeutralLanguage>en</NeutralLanguage>
        <!-- No XML docs for the CLI: the publish output ships the single binary only. -->
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <!-- Keep the CLI clean under Native AOT / trimming (validated with
         `dotnet publish -p:PublishAot=true`); regressions fail the build. -->
        <EnableAotAnalyzer>true</EnableAotAnalyzer>
        <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    </PropertyGroup>

    <!-- NuGet tool package payload. The CLI is a .NET tool, so the readme, license,
         notices and icon travel with the package. -->
    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\" />
        <None Include="..\LICENSE" Pack="true" PackagePath="\" />
        <None Include="..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
        <None Include="..\RVZSharp\icon\icon.png" Pack="true" PackagePath="\" Link="icon.png" />
    </ItemGroup>

    <!-- Single-file distribution: drop the (*.xml) documentation sidecars from the publish
       folder so each runtime directory contains just the executable. -->
    <Target Name="RemoveDocumentationFromPublish" AfterTargets="Publish">
        <ItemGroup>
            <PublishXmlDocs Include="$(PublishDir)**/*.xml" />
        </ItemGroup>
        <Delete Files="@(PublishXmlDocs)" />
    </Target>

    <!-- Ship the CLI binary as RVZSharp[.exe] instead of RVZSharp.Cli[.exe]. The assembly
       keeps its RVZSharp.Cli name: the project reference to the library is also
       RVZSharp.dll, so renaming the assembly would collide in the output folder. The
       single-file apphost can simply be renamed; it loads the embedded assembly. -->
    <Target Name="RenamePublishedCliExecutable" AfterTargets="Publish">
        <PropertyGroup>
            <_CliPublishedExecutable>$(PublishDir)$(AssemblyName)$(_NativeExecutableExtension)</_CliPublishedExecutable>
            <_CliRenamedExecutable>$(PublishDir)RVZSharp$(_NativeExecutableExtension)</_CliRenamedExecutable>
        </PropertyGroup>
        <Copy SourceFiles="$(_CliPublishedExecutable)" DestinationFiles="$(_CliRenamedExecutable)"
              Condition="Exists('$(_CliPublishedExecutable)') and '$(_CliPublishedExecutable)' != '$(_CliRenamedExecutable)'" />
        <Delete Files="$(_CliPublishedExecutable)"
                Condition="Exists('$(_CliRenamedExecutable)') and '$(_CliPublishedExecutable)' != '$(_CliRenamedExecutable)'" />
    </Target>

</Project>
