<Project>

    <!-- Replaces the repo-wide Directory.Build.props for this subtree (MSBuild stops at the
       nearest Directory.Build.props), including BenchmarkDotNet's generated project under
       bin/. The library's target framework and analyzer rules must not apply there: the
       generated project pins its own target framework and the benchmark classes use shapes
       the analyzers reject. -->
    <PropertyGroup>
        <LangVersion>15.0</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
    </PropertyGroup>

</Project>
