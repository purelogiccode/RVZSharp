<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <!-- Benchmarks run on the current runtime only; the library itself is net8.0/9.0/10.0. -->
        <TargetFrameworks>net10.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <!-- BenchmarkDotNet instantiates benchmark classes by reflection and disallows some
         analyzer-suggested shapes; keep this project analyzer-free. -->
        <RunAnalyzers>false</RunAnalyzers>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <Company>PureLogicCode.com</Company>
        <NeutralLanguage>en</NeutralLanguage>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
        <PackageReference Include="Meziantou.Analyzer" Version="3.0.296">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Roslynator.Analyzers" Version="5.0.1">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <ProjectReference Include="..\RVZSharp\RVZSharp.csproj" />
    </ItemGroup>

</Project>
